# Copy this file to .env, fill in the values, then run:
#   docker compose up --build --abort-on-container-exit --exit-code-from harness

# Model name, API key and base URL of any OpenAI-compatible endpoint.
# Offline, no API key: mock/solver (plays the reference answer), mock/idle (does nothing),
# human/solver (you type the model's tool calls; run python -m harness.run in a terminal, not docker compose up).
MODEL=mock/solver
API_KEY=
BASE_URL=

# Which task to run, and the seed used when the task is reset.
TASK_ID=crop_planning
SEED=0

# full      = baseline checks, then the model run on TASK_ID (default)
# all       = baseline checks for every task, then the model on every task in turn (TASK_ID is ignored)
# baselines = baseline checks for every task, no model call
MODE=full

# Optional: extra instructions added to the end of the system prompt, exactly as written.
# Put the file in inputs/ and name it here (e.g. APPEND_FILE=inputs/extra.txt). No rebuild needed.
# Empty = use inputs/append.txt if it exists. A named file that is missing or empty stops the run.
APPEND_FILE=

# Optional: LangGraph runner and LangChain client (lessons 2-3). Both need EXTRAS=langgraph,
# which installs requirements-langgraph.txt into the harness image.
EXTRAS=
RUNNER=loop
CLIENT=openai

# Optional: cap the length of each model reply (leave empty for the model's default).
MAX_TOKENS=
